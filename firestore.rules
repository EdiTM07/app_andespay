rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // Función auxiliar para verificar autenticación
    function isAuthenticated() {
      return request.auth != null;
    }

    match /users/{userId} {
      // Cualquiera autenticado puede leer (necesario para buscar destinatarios por email)
      allow read: if isAuthenticated();
      // Solo el dueño puede modificar su perfil (nombre, teléfono, pin)
      allow write: if request.auth.uid == userId;
    }

    match /accounts/{accountId} {
      // Cualquiera puede leer cuentas para validar escaneo de QR
      allow read: if isAuthenticated();
      
      // IMPORTANTE: En una app bancaria real, las transferencias se procesan
      // en el backend (Cloud Functions/Servidor) aislando la base de datos.
      // Para este proyecto académico (transacciones atómicas desde el cliente),
      // se requiere acceso de escritura a cuentas de terceros para acreditar saldos.
      allow write: if isAuthenticated(); 
    }

    match /transactions/{transactionId} {
      // Un usuario solo puede leer transacciones donde es emisor o receptor
      allow read: if isAuthenticated() && 
                 (resource.data.fromUserId == request.auth.uid || 
                  resource.data.toUserId == request.auth.uid);
                  
      // Solo se pueden registrar transacciones donde el emisor es el usuario actual
      allow create: if isAuthenticated() && request.resource.data.fromUserId == request.auth.uid;
      allow update, delete: if false; // Transacciones inmutables
    }

    match /notifications/{notificationId} {
      // Un usuario solo ve sus propias notificaciones
      allow read: if isAuthenticated() && resource.data.userId == request.auth.uid;
      
      // Un usuario puede marcar sus propias notificaciones como leídas
      allow update: if isAuthenticated() && resource.data.userId == request.auth.uid;
      
      // Permitimos crear notificaciones para otros (ej: alerta de transferencia recibida)
      allow create: if isAuthenticated();
      allow delete: if false;
    }
  }
}
